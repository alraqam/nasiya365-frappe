{
    "creation": "2026-04-09 13:00:00.000000",
    "custom_format": 0,
    "doc_type": "Installment Plan",
    "doctype": "Print Format",
    "font": "Default",
    "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  body { font-family: Arial, sans-serif; font-size: 12px; color: #222; margin: 0; padding: 0; }\n  .contract { width: 100%; max-width: 190mm; margin: 0 auto; padding: 0 4mm; box-sizing: border-box; }\n\n  /* Header */\n  .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #333; padding-bottom: 8px; margin-bottom: 14px; }\n  .header-brand h2 { margin: 0 0 2px; font-size: 16px; }\n  .header-brand p { margin: 0; font-size: 10px; color: #666; }\n  .header-meta { text-align: right; font-size: 11px; }\n  .header-meta .contract-num { font-size: 13px; font-weight: bold; }\n\n  /* Section title */\n  .section-title { font-size: 11px; font-weight: bold; text-transform: uppercase; color: #555; border-bottom: 1px solid #ddd; padding-bottom: 3px; margin: 12px 0 6px; letter-spacing: .5px; }\n\n  /* Info grid */\n  table.info { width: 100%; border-collapse: collapse; margin-bottom: 6px; }\n  table.info td { padding: 3px 8px 3px 0; vertical-align: top; }\n  table.info td.lbl { color: #666; width: 35%; white-space: nowrap; }\n  table.info td.val { font-weight: 600; }\n\n  /* Financial summary box */\n  .fin-grid { display: flex; gap: 6px; margin-bottom: 10px; }\n  .fin-cell { flex: 1; border: 1px solid #ccc; border-radius: 4px; padding: 6px 8px; text-align: center; }\n  .fin-cell .lbl { font-size: 9px; color: #888; margin-bottom: 2px; }\n  .fin-cell .val { font-size: 13px; font-weight: bold; }\n\n  /* Schedule table */\n  table.schedule { width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 10px; }\n  table.schedule th { background: #333; color: #fff; padding: 5px 6px; text-align: center; }\n  table.schedule td { border: 1px solid #ddd; padding: 4px 6px; text-align: center; }\n  table.schedule tr:nth-child(even) td { background: #f9f9f9; }\n  table.schedule td.due { font-weight: 600; }\n\n  /* Terms */\n  .terms { font-size: 10px; color: #555; line-height: 1.5; border: 1px solid #ddd; padding: 8px; border-radius: 3px; margin-bottom: 14px; }\n\n  /* Signatures */\n  .sig-section { display: flex; gap: 20px; margin-top: 20px; }\n  .sig-block { flex: 1; }\n  .sig-block .title { font-size: 10px; font-weight: bold; margin-bottom: 24px; }\n  .sig-block .line { border-top: 1px solid #333; padding-top: 3px; font-size: 10px; color: #666; }\n\n  /* Page break helper */\n  .page-break { page-break-before: always; }\n</style>\n</head>\n<body>\n<div class=\"contract\">\n\n  <!-- ===== HEADER ===== -->\n  <div class=\"header\">\n    <div class=\"header-brand\">\n      <h2>NASIYA365</h2>\n      <p>Платформа рассрочки · nasiya365.uz</p>\n    </div>\n    <div class=\"header-meta\">\n      <div class=\"contract-num\">Договор № {{ doc.contract_number or doc.name }}</div>\n      <div>от {{ frappe.utils.formatdate(doc.start_date) }}</div>\n      {%- if doc.branch %}\n      <div>Филиал: {{ doc.branch }}</div>\n      {%- endif %}\n    </div>\n  </div>\n\n  <!-- ===== PARTIES ===== -->\n  <div class=\"section-title\">Стороны договора</div>\n  {%- set cust = frappe.get_doc(\"Customer Profile\", doc.customer) if doc.customer else none %}\n  <table class=\"info\">\n    <tr>\n      <td class=\"lbl\">Клиент:</td>\n      <td class=\"val\">{{ cust.full_name if cust else doc.customer }}</td>\n      <td class=\"lbl\">Паспорт / ID:</td>\n      <td class=\"val\">{{ cust.passport_number if cust else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"lbl\">Телефон:</td>\n      <td class=\"val\">{{ cust.phone if cust else \"—\" }}</td>\n      <td class=\"lbl\">Адрес:</td>\n      <td class=\"val\">{{ cust.address if cust else \"—\" }}</td>\n    </tr>\n  </table>\n\n  <!-- ===== PRODUCT ===== -->\n  <div class=\"section-title\">Предмет договора</div>\n  <table class=\"info\">\n    <tr>\n      <td class=\"lbl\">Товар:</td>\n      <td class=\"val\">{{ doc.product_name or \"—\" }}</td>\n      <td class=\"lbl\">IMEI / серийный №:</td>\n      <td class=\"val\">{{ doc.imei or \"—\" }}</td>\n    </tr>\n    {%- if doc.sales_order %}\n    <tr>\n      <td class=\"lbl\">Заказ на продажу:</td>\n      <td class=\"val\">{{ doc.sales_order }}</td>\n      <td></td><td></td>\n    </tr>\n    {%- endif %}\n  </table>\n\n  <!-- ===== FINANCIAL SUMMARY ===== -->\n  <div class=\"section-title\">Финансовые условия</div>\n  <div class=\"fin-grid\">\n    <div class=\"fin-cell\">\n      <div class=\"lbl\">Стоимость товара</div>\n      <div class=\"val\">{{ \"%.2f\" | format((doc.principal_amount | float) + (doc.down_payment | float)) }} USD</div>\n    </div>\n    <div class=\"fin-cell\">\n      <div class=\"lbl\">Первоначальный взнос</div>\n      <div class=\"val\">{{ \"%.2f\" | format(doc.down_payment | float) }} USD</div>\n    </div>\n    <div class=\"fin-cell\">\n      <div class=\"lbl\">Сумма рассрочки</div>\n      <div class=\"val\">{{ \"%.2f\" | format(doc.principal_amount | float) }} USD</div>\n    </div>\n    <div class=\"fin-cell\">\n      <div class=\"lbl\">Ставка (%)</div>\n      <div class=\"val\">{{ \"%.1f\" | format(doc.interest_rate | float) }}%</div>\n    </div>\n    <div class=\"fin-cell\">\n      <div class=\"lbl\">Итого к возврату</div>\n      <div class=\"val\">{{ \"%.2f\" | format(doc.total_amount | float) }} USD</div>\n    </div>\n    <div class=\"fin-cell\">\n      <div class=\"lbl\">Ежемесячный платёж</div>\n      <div class=\"val\">{{ \"%.2f\" | format(doc.installment_amount | float) }} USD</div>\n    </div>\n  </div>\n\n  <!-- ===== SCHEDULE ===== -->\n  <div class=\"section-title\">График платежей</div>\n  {%- if doc.schedule %}\n  <table class=\"schedule\">\n    <thead>\n      <tr>\n        <th>#</th>\n        <th>Дата</th>\n        <th>Сумма (USD)</th>\n        <th>Статус</th>\n      </tr>\n    </thead>\n    <tbody>\n    {%- for row in doc.schedule %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td class=\"due\">{{ frappe.utils.formatdate(row.due_date) if row.due_date else \"—\" }}</td>\n        <td>{{ \"%.2f\" | format(row.amount | float) }}</td>\n        <td>{{ row.status or \"Ожидает\" }}</td>\n      </tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n  {%- else %}\n  <p style=\"color:#999;font-size:11px\">График платежей не сформирован.</p>\n  {%- endif %}\n\n  <!-- ===== TERMS ===== -->\n  <div class=\"section-title\">Условия договора</div>\n  <div class=\"terms\">\n    1. Покупатель обязуется вносить ежемесячные платежи согласно графику не позднее указанной даты.<br>\n    2. В случае просрочки платежа более чем на 3 (три) календарных дня начисляется штраф в размере 0.1% от просроченной суммы за каждый день просрочки.<br>\n    3. Товар остаётся в залоге у Продавца до полного погашения задолженности.<br>\n    4. Досрочное погашение допускается без штрафных санкций при условии уведомления Продавца не менее чем за 3 дня.<br>\n    5. Настоящий договор составлен в двух экземплярах, имеющих равную юридическую силу — по одному для каждой из сторон.\n  </div>\n\n  <!-- ===== SIGNATURES ===== -->\n  <div class=\"sig-section\">\n    <div class=\"sig-block\">\n      <div class=\"title\">Продавец (Nasiya365)</div>\n      <div class=\"line\">Подпись: ______________________</div>\n      <div class=\"line\" style=\"margin-top:6px\">Ф.И.О.: ______________________</div>\n      <div class=\"line\" style=\"margin-top:6px\">Дата: ______________________</div>\n    </div>\n    <div class=\"sig-block\">\n      <div class=\"title\">Покупатель</div>\n      <div class=\"line\">Подпись: ______________________</div>\n      <div class=\"line\" style=\"margin-top:6px\">Ф.И.О.: {{ cust.full_name if cust else \"______________________\" }}</div>\n      <div class=\"line\" style=\"margin-top:6px\">Дата: ______________________</div>\n    </div>\n  </div>\n\n</div>\n</body>\n</html>\n",
    "idx": 0,
