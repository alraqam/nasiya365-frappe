{
    "creation": "2026-04-09 13:00:00.000000",
    "custom_format": 0,
    "doc_type": "Payment Transaction",
    "doctype": "Print Format",
    "font": "Default",
    "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  body { font-family: Arial, sans-serif; font-size: 12px; color: #222; margin: 0; padding: 0; }\n  .receipt { width: 100%; max-width: 148mm; margin: 0 auto; padding: 8mm; box-sizing: border-box; }\n  .header { text-align: center; border-bottom: 2px solid #333; padding-bottom: 6px; margin-bottom: 10px; }\n  .header h2 { margin: 4px 0; font-size: 15px; }\n  .header p { margin: 2px 0; font-size: 11px; color: #555; }\n  .doc-num { text-align: center; font-size: 11px; color: #777; margin-bottom: 10px; }\n  table.info { width: 100%; border-collapse: collapse; margin-bottom: 10px; }\n  table.info td { padding: 3px 6px; vertical-align: top; }\n  table.info td:first-child { color: #555; width: 40%; }\n  table.info td:last-child { font-weight: bold; }\n  .amount-box { border: 2px solid #333; border-radius: 4px; padding: 8px 12px; text-align: center; margin: 10px 0; }\n  .amount-box .label { font-size: 11px; color: #555; }\n  .amount-box .value { font-size: 20px; font-weight: bold; }\n  .lines-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }\n  .lines-table th { background: #f0f0f0; border: 1px solid #ccc; padding: 4px 6px; font-size: 11px; }\n  .lines-table td { border: 1px solid #ccc; padding: 4px 6px; font-size: 11px; }\n  .lines-table td:last-child { text-align: right; }\n  .footer { margin-top: 12px; border-top: 1px dashed #aaa; padding-top: 8px; font-size: 10px; color: #777; text-align: center; }\n  .sig-line { margin-top: 16px; border-top: 1px solid #333; padding-top: 4px; font-size: 10px; color: #555; }\n</style>\n</head>\n<body>\n<div class=\"receipt\">\n  <div class=\"header\">\n    <h2>NASIYA365</h2>\n    <p>Квитанция об оплате</p>\n  </div>\n\n  <div class=\"doc-num\">\n    № {{ doc.name }} &nbsp;|&nbsp; {{ frappe.utils.formatdate(doc.posting_date or frappe.utils.today()) }}\n  </div>\n\n  <table class=\"info\">\n    <tr>\n      <td>Клиент:</td>\n      <td>{{ doc.customer_name or doc.customer or \"—\" }}</td>\n    </tr>\n    {%- if doc.customer_phone %}\n    <tr>\n      <td>Телефон:</td>\n      <td>{{ doc.customer_phone }}</td>\n    </tr>\n    {%- endif %}\n    {%- if doc.reference_name %}\n    <tr>\n      <td>Договор:</td>\n      <td>{{ doc.reference_name }}</td>\n    </tr>\n    {%- endif %}\n    <tr>\n      <td>Метод:</td>\n      <td>{{ doc.payment_method or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td>Принял:</td>\n      <td>{{ frappe.db.get_value(\"User\", doc.received_by, \"full_name\") or doc.received_by or \"—\" }}</td>\n    </tr>\n  </table>\n\n  <div class=\"amount-box\">\n    <div class=\"label\">Принято</div>\n    <div class=\"value\">{{ \"%.2f\" | format(doc.amount | float) }} USD</div>\n  </div>\n\n  {%- if doc.payment_lines %}\n  <table class=\"lines-table\">\n    <thead>\n      <tr>\n        <th>Метод</th>\n        <th>Валюта</th>\n        <th>Сумма</th>\n      </tr>\n    </thead>\n    <tbody>\n    {%- for line in doc.payment_lines %}\n      <tr>\n        <td>{{ line.payment_method or \"—\" }}</td>\n        <td>{{ line.currency or \"USD\" }}</td>\n        <td>{{ \"%.2f\" | format(line.amount | float) }}</td>\n      </tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n  {%- endif %}\n\n  {%- if doc.notes %}\n  <p style=\"font-size:11px;color:#555\">Примечание: {{ doc.notes }}</p>\n  {%- endif %}\n\n  <div class=\"sig-line\">Подпись кассира: ______________________</div>\n\n  <div class=\"footer\">\n    Сохраните квитанцию. Насия365 — ваш надёжный партнёр.\n  </div>\n</div>\n</body>\n</html>\n",
